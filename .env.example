# ========================================================
# TravelSplit iOS Environment Variables Template
# Copy this file to .env.development or .env.production
# ========================================================

# App Environment (development | production | test)
VITE_ENVIRONMENT=development

# Backend REST API Server URL
# For local dev: http://localhost:5000/api
# For production: /api (if proxied) or https://api.yourdomain.com/api
VITE_API_URL=http://localhost:5000/api

# Convex Real-Time Serverless Database URL
# Run `npx convex dev` to generate your free dev database URL
VITE_CONVEX_URL=https://your-deployment-name.convex.cloud

# Optional Display Title
VITE_APP_TITLE=TravelSplit iOS
